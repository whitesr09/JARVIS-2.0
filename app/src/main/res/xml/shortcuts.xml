<?xml version="1.0" encoding="utf-8"?>
<!-- v1.9.0 (#112): static launcher shortcuts. Each opens MainActivity
     with the open_screen extra, handled by handleNavIntent. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nshd.jarvis2"
            android:targetClass="com.nshd.jarvis2.MainActivity">
            <extra
                android:name="open_screen"
                android:value="voice" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="chat"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_chat_short"
