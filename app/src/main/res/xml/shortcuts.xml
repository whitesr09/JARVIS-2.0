        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nshd.jarvis2"
            android:targetClass="com.nshd.jarvis2.MainActivity">
            <extra
                android:name="open_screen"
                android:value="chat" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="handsfree"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_handsfree_short"
        android:shortcutLongLabel="@string/shortcut_handsfree_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nshd.jarvis2"
            android:targetClass="com.nshd.jarvis2.MainActivity">
            <extra
                android:name="open_screen"
                android:value="handsfree" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="selftest"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_selftest_short"
        android:shortcutLongLabel="@string/shortcut_selftest_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nshd.jarvis2"
            android:targetClass="com.nshd.jarvis2.MainActivity">
            <extra
                android:name="open_screen"
                android:value="selftest" />
        </intent>
    </shortcut>
</shortcuts>
