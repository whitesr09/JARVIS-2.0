<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Jarvis stores provider configuration, memory, local voice samples, and
         logs in app-private storage. Backups are intentionally disabled so a
         device migration cannot silently transfer secrets or personal data. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
